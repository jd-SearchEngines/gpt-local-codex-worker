{
  "name": "gpt-local-codex-worker",
  "version": "0.1.0",
  "private": false,
  "description": "A local worker that executes trusted GitHub Codex tasks with the Codex SDK.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/cli.ts worker",
    "worker:once": "node --env-file-if-exists=.env --import tsx src/cli.ts once",
    "worker:status": "node --env-file-if-exists=.env --import tsx src/cli.ts status",
    "test:e2e": "node --env-file-if-exists=.env --import tsx scripts/test-e2e.ts",
    "registry:sync": "node --env-file-if-exists=.env --import tsx scripts/sync-project-registry.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@openai/codex-sdk": "latest",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0-dev.20251108"
  }
}
